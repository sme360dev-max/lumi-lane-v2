{
  "name": "lumi-lane-version2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "postbuild": "node scripts/flatten-rsc.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
