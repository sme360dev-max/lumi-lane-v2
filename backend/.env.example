# Lumi Lane backend settings.
# .env (local), .env.prod (production) and this .env.example share the same lines in the same order.
# Django reads backend/.env; run with DJANGO_ENV_FILE=.env.prod to use the production file.
# Real environment variables (e.g. on Render) override anything in these files.

# --- Django ---------------------------------------------------------------
# true for local development, false in production.
DJANGO_DEBUG=true
# Long random string. Production must use its own value.
DJANGO_SECRET_KEY=local-development-only-change-this
# Comma-separated host names this API answers on, e.g. your-service.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Website origins --------------------------------------------------------
# Website origins allowed to call the API (Cloudflare Pages domain in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HTTPS origins trusted for admin form posts, comma-separated.
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Supabase Postgres session-pooler URL (port 5432). Leave empty to use backend/db.sqlite3.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
DATABASE_URL=
DB_SSLMODE=require
# Seconds to keep a database connection open between requests.
DB_CONN_MAX_AGE=60

# --- Email (Brevo) ----------------------------------------------------------
# Brevo transactional email API key. Not needed locally: emails print in the terminal.
BREVO_API_KEY=
# Sender address verified in Brevo, e.g. Lumi Lane <bookings@your-domain.com>
DEFAULT_FROM_EMAIL=Lumi Lane <no-reply@example.com>
# Venue inbox that receives new booking alerts.
BOOKING_NOTIFICATION_EMAIL=

# --- Public URL -------------------------------------------------------------
# Public URL of this API, used for the admin link in booking emails.
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_WEBSITE_URL=http://localhost:3000
